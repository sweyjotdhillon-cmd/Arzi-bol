# ==============================================================================
# Arzi-Bol Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values for live Sarvam AI mode.
# If .env is omitted or SARVAM_API_KEY is empty, the app boots in Local Demo Mode.

# Sarvam AI API Key (Server-side only — NEVER expose to frontend)
SARVAM_API_KEY=your_key_here

# Backend Express server configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:8080

# Frontend API base URL (proxied through nginx in Docker or Vite dev server)
VITE_API_URL=/api
